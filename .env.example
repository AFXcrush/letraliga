# Copiá este archivo a ".env" y completá con los datos de tu proyecto Supabase
# para habilitar el juego online. Mientras no existan, la app funciona 100%
# en modo local (pasar y jugar) sin necesitar backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# En Authentication > Providers debe habilitarse Anonymous Sign-Ins.
